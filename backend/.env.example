# Required Environment Variables for CyclogenAI Backend

# MongoDB Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>/cyclogenai?retryWrites=true&w=majority

# Port configuration (default: 3001)
PORT=3001

# LLM — set LLM_PROVIDER=groq to use Groq when Gemini quota is exhausted
# GOOGLE_GENERATIVE_AI_API_KEY=key1,key2
# GOOGLE_GENERATIVE_AI_SYNC_API_KEYS=key1,key2
# GOOGLE_GENERATIVE_AI_PLAN_API_KEYS=key1,key2   # Dedicated keys for plan generation (crucial — uses separate quota)
# GOOGLE_LLM_MODEL=gemini-2.0-flash-lite
# GROQ_API_KEY=key1,key2
# GROQ_CHAT_MODEL=llama-3.1-8b-instant
# GROQ_FALLBACK_MODELS=llama-3.3-70b-versatile
# GROQ_MODEL=llama-3.3-70b-versatile
# LLM_PROVIDER=auto

# Future placeholders
# JWT_SECRET=
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
# OPENAI_API_KEY=
