# Required Environment Variables for CycloAI Backend

# MongoDB Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>/cycloai?retryWrites=true&w=majority

# Port configuration (default: 3001)
PORT=3001

# Future placeholders
# JWT_SECRET=
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
# OPENAI_API_KEY=
