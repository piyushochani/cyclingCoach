# Required Environment Variables for CyclogenAI Backend

# MongoDB Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>/cyclogenai?retryWrites=true&w=majority

# Port configuration (default: 3001)
PORT=3001

# JWT Authentication
JWT_SECRET=your-jwt-secret-here

# Redis / BullMQ — local dev uses in-process MockQueue (no Redis required)
REDIS_ENABLED=false
# Production only (Railway / Render / docker-compose.prod.yml):
# REDIS_ENABLED=true
# REDIS_HOST=<host>          # Railway: ${{Redis.REDISHOST}}  Docker prod: redis
# REDIS_PORT=6379            # Railway: ${{Redis.REDISPORT}}

# Pinecone (vector store for RAG)
PINECONE_API_KEY=
PINECONE_HOST=
PINECONE_INDEX=CyclingCoach
PINECONE_NAMESPACE=
PINECONE_MIN_SCORE=0.5

# LLM — set LLM_PROVIDER=groq to use Groq when Gemini quota is exhausted
GOOGLE_GENERATIVE_AI_API_KEY=key1,key2
GOOGLE_GENERATIVE_AI_SYNC_API_KEYS=key1,key2
GOOGLE_GENERATIVE_AI_PLAN_API_KEYS=key1,key2
GOOGLE_LLM_MODEL=gemini-2.0-flash-lite
# GROQ_API_KEY=key1,key2
# GROQ_CHAT_MODEL=llama-3.1-8b-instant
# GROQ_FALLBACK_MODELS=llama-3.3-70b-versatile
# GROQ_MODEL=llama-3.3-70b-versatile
# LLM_PROVIDER=auto

# Strava OAuth (app credentials — tokens stored per-user in MongoDB)
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
# STRAVA_REDIRECT_URI=http://localhost:3000/auth/strava/callback
STRAVA_SYNC_MONTHS=6

# Frontend URL (for Strava OAuth redirect links)
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_API_URL=http://localhost:3001

# Email (optional)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=

# Cloudinary (optional, for image uploads)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Dummy payment (dev/test — accepts 111111111111 / 11/11 / 111)
DUMMY_CARD=111111111111
DUMMY_EXPIRY=11/11
DUMMY_CVC=111
