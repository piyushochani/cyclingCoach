# Required Environment Variables for CyclogenAI Backend

# MongoDB Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>/cyclogenai?retryWrites=true&w=majority

# Port configuration (default: 3001)
PORT=3001

# JWT Authentication
JWT_SECRET=your-jwt-secret-here

# Redis / BullMQ (set REDIS_ENABLED=false for local dev without Docker)
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379

# Pinecone (vector store for RAG)
PINECONE_API_KEY=
PINECONE_HOST=
PINECONE_INDEX=CyclingCoach
PINECONE_NAMESPACE=
PINECONE_MIN_SCORE=0.5

# LLM — set LLM_PROVIDER=groq to use Groq when Gemini quota is exhausted
GOOGLE_GENERATIVE_AI_API_KEY=key1,key2
GOOGLE_GENERATIVE_AI_SYNC_API_KEYS=key1,key2
GOOGLE_GENERATIVE_AI_PLAN_API_KEYS=key1,key2
GOOGLE_LLM_MODEL=gemini-2.0-flash-lite
# GROQ_API_KEY=key1,key2
# GROQ_CHAT_MODEL=llama-3.1-8b-instant
# GROQ_FALLBACK_MODELS=llama-3.3-70b-versatile
# GROQ_MODEL=llama-3.3-70b-versatile
# LLM_PROVIDER=auto

# Strava (global credentials — per-user OAuth wiring is separate)
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
STRAVA_SYNC_MONTHS=6

# Frontend URL (for Strava OAuth redirect links)
# NEXT_PUBLIC_API_URL=http://localhost:3001

# Email (optional)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=

# Cloudinary (optional, for image uploads)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Stripe (optional — not wired in AppModule yet)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# R2/S3 object storage (optional — not wired yet)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
